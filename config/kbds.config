// kbds.config — KISTI K-BDS profile for nf_scripts/RAWREAD_QC_cleanifier.nf
//
// Written in Nextflow's strict configuration syntax (Nextflow >= 25.04, the default
// parser in >= 26.x), independent of config/nextflow.config (legacy syntax, containers).
//
//   nextflow run RAWREAD_QC_cleanifier.nf -c config/kbds.config -profile kbds ...
//
// K-BDS: CentOS 7, Slurm, exclusive nodes billed per node-hour, no container runtime
// assumed. One sbatch = one node = one `nextflow run` with the local executor; the local
// executor's capacity defaults to the node's CPU count (nproc) and every process reserves
// `cpus` slots of it. Tools come from a conda environment (scripts/rawreadqc/kbds_env.yml):
// activate it before `nextflow run` (tasks inherit PATH) or pass --conda_env <name|path> so
// that every task activates it itself.
// trace/report go to params.run_dir (default: the launch directory) with a fixed field list
// that external monitors parse (raw values: epoch ms, bytes).

profiles {
    kbds {
        params {
            run_dir           = "${launchDir}"
            work_dir          = "${launchDir}/work"
            fifo_dir          = '/tmp'
            conda_env         = ''
            conda_sh          = '~/miniconda3/etc/profile.d/conda.sh'
            numba_cache_dir   = "${launchDir}/.numba_cache"
            cleanifier_shared = true
            cpus              = 4
        }

        workDir = params.work_dir

        apptainer.enabled   = false
        singularity.enabled = false
        docker.enabled      = false
        conda.enabled       = false

        executor {
            name = 'local'
        }

        process {
            executor     = 'local'
            shell        = ['/bin/bash', '-euo', 'pipefail']
            // optional per-task conda activation (empty string = inherit the launching environment)
            beforeScript = params.conda_env ? "set +u; source ${params.conda_sh}; conda activate ${params.conda_env}; set -u" : ''
        }

        env {
            NUMBA_CACHE_DIR = params.numba_cache_dir
            OMP_NUM_THREADS = '1'
            MKL_NUM_THREADS = '1'
        }

        trace {
            enabled   = true
            overwrite = true
            raw       = true
            file      = "${params.run_dir}/trace.txt"
            fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,cpus,memory,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar,workdir'
        }
        report {
            enabled   = true
            overwrite = true
            file      = "${params.run_dir}/report.html"
        }
        timeline.enabled = false
        dag.enabled      = false
    }
}

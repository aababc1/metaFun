        }
        trace {
            enabled = true
            file = "${params.report_outdir}/trace_ASSEMBLY_BINNING_${timestamp}.txt"
        }
        dag {
            enabled = true
            file = "${params.report_outdir}/dag_ASSEMBLY_BINNING_${timestamp}.svg"
        }
    }

    BIN_ASSESSMENT {

    }

    WMS_STRAIN {
        report {
            enabled = true
            file = "${params.report_outdir}/report_WMS_STRAIN_${timestamp}.html"
        }
        timeline {
            enabled = true
            file = "${params.report_outdir}/timeline_WMS_STRAIN_${timestamp}.html"
        }
        trace {
            enabled = true
            file = "${params.report_outdir}/trace_WMS_STRAIN_${timestamp}.txt"
        }
        dag {
            enabled = true
            file = "${params.report_outdir}/dag_WMS_STRAIN_${timestamp}.svg"
        }
    }

    ////////////////////////////////////////////////////////////////////////
    // kbds: KISTI K-BDS (CentOS 7, Slurm, exclusive nodes billed per node-hour,
    // no container runtime assumed). One sbatch = one node = one `nextflow run`
    // with the local executor; every process reserves `cpus` slots out of nproc.
    // Tools come from a conda environment (see scripts/rawreadqc/kbds_env.yml);
    // either activate it before `nextflow run` (tasks inherit PATH) or pass
    // --conda_env <path> so that every task activates it itself.
    // Used with nf_scripts/RAWREAD_QC_cleanifier.nf; trace/report go to
    // params.run_dir (default: the launch directory) with a fixed field list
    // that external monitors parse (raw values: epoch ms, bytes).
    ////////////////////////////////////////////////////////////////////////
    kbds {
        params {
            run_dir           = "${launchDir}"
            work_dir          = "${launchDir}/work"
            fifo_dir          = '/tmp'
            conda_env         = ''
            conda_sh          = '/apps/application/miniconda3/etc/profile.d/conda.sh'
            numba_cache_dir   = "${System.getenv('HOME') ?: launchDir}/metaCRC/db/cleanifier/numba_cache"
            cleanifier_shared = true
            cpus              = 4
        }

        workDir = params.work_dir

        apptainer.enabled   = false
        singularity.enabled = false
        docker.enabled      = false

        executor {
            name = 'local'
            cpus = Runtime.runtime.availableProcessors()
        }

        process {
            executor  = 'local'
            container = ''
            shell     = ['/bin/bash', '-euo', 'pipefail']
            // optional per-task conda activation (empty string = inherit the launching environment)
            beforeScript = params.conda_env ? "set +u; source '${params.conda_sh}'; conda activate '${params.conda_env}'; set -u" : ''
        }

        env {
            NUMBA_CACHE_DIR = params.numba_cache_dir
            OMP_NUM_THREADS = '1'
            MKL_NUM_THREADS = '1'
        }

        trace {
            enabled   = true
            overwrite = true
            raw       = true
            file      = "${params.run_dir}/trace.txt"
            fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,cpus,memory,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar,workdir'
        }
        report {
            enabled   = true
            overwrite = true
            file      = "${params.run_dir}/report.html"
        }
        timeline { enabled = false }
        dag      { enabled = false }
    }
}
//pipelines execution result report area

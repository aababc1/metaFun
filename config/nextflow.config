            enabled = true
            file = "${params.report_outdir}/report_WMS_TAXONOMY_${timestamp}.html"
        }
        timeline {
            enabled = true
            file = "${params.report_outdir}/timeline_WMS_TAXONOMY_${timestamp}.html"
        }
        trace {
            enabled = true
            file = "${params.report_outdir}/trace_WMS_TAXONOMY_${timestamp}.txt"
        }
